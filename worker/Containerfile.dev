ARG WORKER_NODE_IMAGE=docker.io/library/node:24.22.1-bookworm-slim
FROM ${WORKER_NODE_IMAGE}

# Custom/cached base images must use the same patched Node executable.
COPY --from=docker.io/library/node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 /usr/local/bin/node /usr/local/bin/node

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    python3 \
    ruby \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["bash", "/workspace/scripts/podman-worker-entrypoint.sh"]
